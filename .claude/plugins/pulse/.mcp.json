{
  "mcpServers": {
    "pulse-engine": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "C:/Users/bbrav/genesis:/work",
        "-v",
        "pulse-linux-venv:/work/.venv",
        "-v",
        "uv_warm_cache:/tmp/uv-cache",
        "-w",
        "/work",
        "-e",
        "PULSE_WORKSPACE_ROOT=/work",
        "-e",
        "PULSE_SQLITE_PATH=/work/.pulse/state.sqlite",
        "-e",
        "UV_HTTP_TIMEOUT=1800",
        "ghcr.io/bajmein/pulse/mcp-pulse:latest"
      ]
    }
  }
}
