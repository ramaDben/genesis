{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Replace|GithubPush|GithubCreatePR",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "pulse-engine",
            "tool": "mcp__pulse__validate_tool_use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|Replace|GithubPush|GithubCreatePR",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "pulse-engine",
            "tool": "mcp__pulse__log_audit_event"
          }
        ]
      }
    ]
  }
}
