{
  "enabledMcpjsonServers": [
    "filesystem",
    "memory",
    "serena"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .agents/hooks/run_hook.sh session_context.py --client claude",
            "statusMessage": "Cargando memorias y estado del proyecto"
          },
          {
            "type": "mcp_tool",
            "server": "omega-memory",
            "tool": "omega_welcome"
          }
        ]
      }
    ]
  }
}
