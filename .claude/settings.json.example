{
  "_comentario": "OBSOLETO — NO renombrar a settings.json (2026-09-05). Los hooks ya están activos en .claude/settings.json, despachados por .agents/hooks/run_hook.sh. Este archivo se conserva sólo como referencia de permisos sugeridos.",
  "_por_que_no_usarlo": "Los comandos de hook de acá invocan 'uv run .agents/hooks/...' directamente. Medido el 2026-09-05: desde una sesión de Claude Code en Windows eso corre sobre UNC, leer .pulse/state.sqlite devuelve 'database is locked', el hook reporta fase 'unknown' y emite contexto vacío SIN fallar — un control que miente en silencio. Hay que pasar por run_hook.sh. Además los matchers de grep/find/sed/awk suponen rg/fd instalados; se instalaron en el WSL el 2026-09-05, pero no los damos por hechos en otras máquinas.",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv *)",
      "Bash(ty *)",
      "Bash(mise *)",
      "mcp__serena__*",
      "mcp__sequential-thinking__*",
      "Bash(eza *)",
      "Bash(lsd *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(ast-grep *)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .agents/hooks/sdd_context_injector.py --client claude",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(grep *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'DeterministicToolEnforcement: Use rg instead of grep for better performance' && exit 2"
          }
        ]
      },
      {
        "matcher": "Bash(find *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'DeterministicToolEnforcement: Use fd instead of find' && exit 2"
          }
        ]
      },
      {
        "matcher": "Bash(sed *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'DeterministicToolEnforcement: Use rg/fd/ast-grep or targeted file edits instead of sed' && exit 2"
          }
        ]
      },
      {
        "matcher": "Bash(awk *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'DeterministicToolEnforcement: Use rg/fd/ast-grep or structured tooling instead of awk' && exit 2"
          }
        ]
      }
    ]
  }
}
