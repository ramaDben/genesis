# Plantilla de entorno de genesis — copiar a `.env` y completar.
#
#   cp .env.example .env
#
# `.env` está en .gitignore y NUNCA se commitea. Esta plantilla sí se versiona:
# no pongas valores reales acá.
#
# Ninguna de estas variables la lee el pipeline de backtest/validación: todas
# aplican al flujo SDD interno (motor Pulse). `mise` carga este archivo vía
# `_.file = ".env"`, así que debe existir aunque los valores queden en placeholder.

# ==========================================
# SECRETOS E INTEGRACIONES (No commitear)
# ==========================================
# Requerido: Token de GitHub para la memoria FSM y manipulación de issues/labels.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# Requerido: Token de Context 7 para hidratación universal del contexto.
CONTEXT7_API_KEY=ctx7sk-your_context7_token_here

# Opcional: Token de Anthropic si el motor orquesta de manera autónoma.
PULSE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_token_here

# ==========================================
# CONFIGURACIÓN DEL MOTOR PULSE (FSM)
# ==========================================
# Entorno de ejecución: development, staging, production
PULSE_ENVIRONMENT=development

# Nivel de verbosidad de logs: DEBUG, INFO, WARNING, ERROR
PULSE_LOG_LEVEL=INFO

# --- Rutas Centralizadas (absolutas; ajustar a la ruta local del clon) ---
# En Windows usar barras normales: C:/ruta/al/repo
# Ruta absoluta a la raíz del repositorio
PULSE_WORKSPACE_ROOT=/ruta/absoluta/al/repo

# Nombre de la carpeta de estado (generalmente .pulse)
PULSE_META_DIR_NAME=.pulse

# Ruta absoluta al SQLite del FSM
PULSE_SQLITE_PATH=/ruta/absoluta/al/repo/.pulse/state.sqlite

# Ruta absoluta para el servidor MCP Memory (Knowledge Graph)
MEMORY_FILE_PATH=/ruta/absoluta/al/repo/.pulse/memory/knowledge-graph.jsonl

# --- Comportamiento del Engine ---
# Stream de eventos
PULSE_ENABLE_CTX_STREAMING=true

# Límite de subagentes en delegación Swarm
PULSE_MAX_CONCURRENT_AGENTS=4

# Timeout en segundos para transiciones de fase (incluyendo la toolchain de review)
PULSE_TRANSITION_TIMEOUT_SECONDS=300

# Límite de inserción de heurísticas pasadas en la fase Apply
PULSE_MAX_HEURISTICS=3
