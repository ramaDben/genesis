# Plantilla de entorno de genesis — copiar a `.env` y completar.
#
#   cp .env.example .env
#
# `.env` está en .gitignore y NUNCA se commitea. Esta plantilla sí se versiona:
# no pongas valores reales acá.
#
# Ninguna de estas variables la lee el pipeline de backtest/validación: son de
# las integraciones del entorno de desarrollo. `mise` carga este archivo vía
# `_.file = ".env"`, así que debe existir aunque los valores queden en placeholder.

# ==========================================
# SECRETOS E INTEGRACIONES (No commitear)
# ==========================================
# Requerido: Token de GitHub para la manipulación de issues/labels.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# Requerido: Token de Context 7 para hidratación universal del contexto.
CONTEXT7_API_KEY=ctx7sk-your_context7_token_here

# Ruta absoluta para el servidor MCP Memory (Knowledge Graph)
MEMORY_FILE_PATH=/ruta/absoluta/al/repo/.pulse/memory/knowledge-graph.jsonl
