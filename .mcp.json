{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-filesystem C:/Users/bbrav/genesis"
      ]
    },
    "memory": {
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/bbrav/genesis/.pulse/memory/knowledge-graph.jsonl"
      }
    },
    "serena": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx --from git+https://github.com/oraios/serena serena start-mcp-server --context claude-code --project C:/Users/bbrav/genesis"
      ]
    }
  }
}
