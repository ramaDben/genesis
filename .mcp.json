{
  "mcpServers": {
    "filesystem": {
      "command": "bash",
      "args": [
        "-c",
        "npx -y @modelcontextprotocol/server-filesystem \"$(git rev-parse --show-toplevel)\""
      ]
    },
    "memory": {
      "command": "bash",
      "args": [
        "-c",
        "MEMORY_FILE_PATH=\"$(git rev-parse --show-toplevel)/.pulse/memory/knowledge-graph.jsonl\" exec npx -y @modelcontextprotocol/server-memory"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    }
  }
}
